# This static site does not require server-side environment variables.
# Public contact values are configured in site-config.js because they must be
# available to the browser to build direct WhatsApp links.
# Never add private keys or secrets to site-config.js or any committed file.
PUBLIC_WHATSAPP_NUMBER=919999999999
PUBLIC_EMAIL=hello@example.com
PUBLIC_SITE_URL=https://example.com
